{
  "name": "git-suite",
  "version": "1.0.0",
  "description": "npm package to simplify git commit flow",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "test": "node ./src/index.js",
    "format": "prettier --write \"src/**/*.js\""
  },
  "bin": {
    "gs": "src/index.js"
  },
  "dependencies": {
    "chalk": "5.0.1",
    "dotenv": "16.4.7"
  },
  "engines": {
    "node": ">=16.14.2",
    "npm": ">=7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucasGobatto/git-suite.git"
  },
  "keywords": [
    "git",
    "gitflow",
    "cli"
  ],
  "author": "LucasGobatto",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/LucasGobatto/git-suite/issues"
  },
  "homepage": "https://github.com/LucasGobatto/git-suite#readme",
  "imports": {
    "#log": "./src/log/log.js",
    "#utils/*": "./src/scripts/utils/*.js",
    "#tasks": "./src/scripts/tasks/index.js"
  },
  "devDependencies": {
    "prettier": "^3.8.3"
  }
}
